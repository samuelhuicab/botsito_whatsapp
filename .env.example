# ─── Bot ────────────────────────────────────────────────────────────────
# Nombre con el que el bot se presenta
BOT_NAME=botsito
# Palabra para platicar con el bot (ej. "bot ¿qué onda?")
BOT_TRIGGER=bot
# Prefijo de los comandos (ej. !ping)
COMMAND_PREFIX=!
# Tu número con código de país, solo dígitos (ej. 5215512345678). Habilita comandos ownerOnly.
OWNER_NUMBER=

# ─── IA ─────────────────────────────────────────────────────────────────
# Segundos que cada usuario espera entre usos de IA
AI_USER_COOLDOWN=10
# Mensajes recientes que se recuerdan por chat en modo plática
AI_HISTORY_SIZE=6
# Tope de tokens por respuesta (bajo = ahorra cuota gratis)
AI_MAX_TOKENS=300
# Segundos que se "descansa" un proveedor cuando responde 429 (límite alcanzado)
AI_COOLDOWN_ON_429=60
# Orden en que se prueban los proveedores (solo se usan los que tengan clave)
AI_PROVIDER_ORDER=groq,gemini,openrouter

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# OpenRouter (modelos gratis terminan en :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ─── Otros ──────────────────────────────────────────────────────────────
# Timeout en segundos para APIs externas (ctx.http)
HTTP_TIMEOUT=10
# Nivel de logs: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Variables de tus comandos privados van abajo (no las subas):
